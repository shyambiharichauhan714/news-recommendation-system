# Copy this file to .env and adjust as needed.

# Database — SQLite by default. To switch to PostgreSQL later, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/newsmind
DATABASE_URL=sqlite:///./data/newsmind.db

# Auth
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS — origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ML
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEQUENCE_LENGTH=5
GRU_HIDDEN_DIM=128
GRU_NUM_LAYERS=2
GRU_DROPOUT=0.3
LEARNING_RATE=0.001
BATCH_SIZE=32
EPOCHS=40
