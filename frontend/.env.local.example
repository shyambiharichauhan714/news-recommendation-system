# Copy this file to .env.local and adjust as needed.

# Origin of the FastAPI backend (used server-side by next.config.js rewrites)
BACKEND_ORIGIN=http://localhost:8000

# Public API base path used by the browser (kept relative so the Next.js
# rewrite proxy forwards it to BACKEND_ORIGIN — avoids CORS in dev)
NEXT_PUBLIC_API_URL=/api
