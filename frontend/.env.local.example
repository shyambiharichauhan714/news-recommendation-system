# Copy to .env.local for local development.

# Origin of the API. Locally this is the uvicorn server; on Vercel set this
# in the project's Environment Variables to the deployed API URL, e.g.
#   BACKEND_ORIGIN=https://newsmind-api.vercel.app
BACKEND_ORIGIN=http://localhost:8000

# Public API base path used by the browser. Kept relative so requests go
# through the Next.js rewrite above rather than cross-origin.
NEXT_PUBLIC_API_URL=/api
